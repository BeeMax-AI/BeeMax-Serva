# Node 24+; load using node --env-file=.env server/src/index.ts
HOST=127.0.0.1
PORT=8766
# DATA_PROVIDER=local  # explicitly opt into local sample data
DATA_DIR=.local
# Automatically selects MCP when DATA_DIR/mcp-connection.json exists.
# Server-only JSON: url, tenantId, tenantName, referenceLabel (optional).
# MCP_CONFIG_FILE=/absolute/private/mcp-connection.json
# DATA_PROVIDER=mcp
# Optional OpenAI-compatible model gateway (server side only)
# AI_BASE_URL=https://your-gateway.example/v1/
# AI_API_KEY=
# AI_MODEL=
# For deployment behind HTTPS:
# APP_PUBLIC_URL=https://service.example.com
# SESSION_SECURE=true
