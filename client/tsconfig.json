{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
